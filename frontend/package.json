{
  "name": "score-docs-assistant-frontend",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "Local web UI for the S-CORE Docs Assistant (F006). Built to a static bundle served by the FastAPI backend; no separate server in production.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "license-check": "license-checker-rseidelsohn --json --excludePrivatePackages",
    "check-no-third-party-assets": "node scripts/check-no-third-party-assets.mjs",
    "check-no-telemetry": "node scripts/check-no-telemetry.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "25.0.1",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
